              "console.log(pm.response.text());",
              "pm.test('HTTP 2xx', function () {",
              "    pm.expect(pm.response.code).to.be.within(200, 299);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/xml" }
        ],
        "body": {
          "mode": "raw",
          "options": { "raw": { "language": "xml" } },
          "raw": "<TransactionSet xmlns=\"http://schemas.datacontract.org/2004/07/P21.Transactions.Model.V2\" xmlns:i=\"http://www.w3.org/2001/XMLSchema-instance\">\n  <Name>Order</Name>\n  <Transactions>\n    <Transaction>\n      <DataElements>\n        <DataElement>\n          <Keys xmlns:a=\"http://schemas.microsoft.com/2003/10/Serialization/Arrays\" />\n          <Name>TABPAGE_1.order</Name>\n          <Rows>\n            <Row>\n              <Edits>\n                <Edit><Name>order_no</Name><Value>{{cancel_order_no}}</Value></Edit>\n                <Edit><Name>cancel_flag</Name><Value>Y</Value></Edit>\n              </Edits>\n            </Row>\n          </Rows>\n          <Type>Form</Type>\n        </DataElement>\n      </DataElements>\n      <Documents i:nil=\"true\" />\n      <Status>New</Status>\n    </Transaction>\n  </Transactions>\n  <UseCodeValues>false</UseCodeValues>\n</TransactionSet>"
        },
        "url": "{{base_url}}/uiserver0/api/v2/Transaction"
      }
    }
  ],
